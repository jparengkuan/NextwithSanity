node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# turbo
.turbo/

# next.js
.next/
out/
next-env.d.ts

# sanity
.sanity/
dist/

# testing
coverage/

# env files (keep the examples)
.env
.env.*
!.env.example

# vercel
.vercel/

# typescript
*.tsbuildinfo

# logs
logs/
*.log
